{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cerberus",
  "version": "0.1.0",
  "identifier": "io.github.hash066.cerberus",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node build-sidecar.mjs",
    "beforeBuildCommand": "node build-sidecar.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cerberus — Mesh Control",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/cerberusd"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
